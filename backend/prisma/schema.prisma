datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id                    String            @id @default(uuid())
  role                  String            // 'student', 'recruiter', 'admin'
  fullName              String?
  email                 String            @unique
  createdAt             DateTime          @default(now())

  studentProfile        StudentProfile?
  recruiterProfile      RecruiterProfile?
  reviewedOpportunities Opportunity[]     @relation("AdminReviewedOpportunities")
  approvedRecruiters    RecruiterProfile[] @relation("AdminApprovedRecruiters")
}

model RecruiterProfile {
  id                  String       @id
  profile             Profile      @relation(fields: [id], references: [id], onDelete: Cascade)
  organizationName    String
  organizationWebsite String?
  jobTitle            String?
  status              String       @default("pending") // 'pending', 'approved', 'suspended', 'rejected'
  approvedBy          String?
  approver            Profile?     @relation("AdminApprovedRecruiters", fields: [approvedBy], references: [id])
  approvedAt          DateTime?
  opportunities       Opportunity[]
}

model StudentProfile {
  id                   String              @id
  profile              Profile             @relation(fields: [id], references: [id], onDelete: Cascade)
  phone                String?
  location             String?
  country              String?
  headline             String?
  bio                  String?
  profileEmbedding     String?             // JSON vector string
  profileCompletionPct Int                 @default(0)
  updatedAt            DateTime            @default(now()) @updatedAt

  educations           Education[]
  studentSkills        StudentSkill[]
  experiences          Experience[]
  projects             Project[]
  certifications       Certification[]
  courses              Course[]
  communityWork        CommunityWork[]
  leadership           Leadership[]
  achievements         Achievement[]
  preferences          StudentPreference?
  matches              Match[]
  emailLogs            EmailLog[]
  applications         Application[]
}

model Education {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution    String
  degree         String?
  fieldOfStudy   String?
  gpa            Float?
  gpaScale       Float          @default(4.0)
  startDate      DateTime?
  graduationDate DateTime?
  isCurrent      Boolean        @default(false)
}

model Skill {
  id                String             @id @default(uuid())
  name              String             @unique
  studentSkills     StudentSkill[]
  experienceSkills  ExperienceSkill[]
  opportunitySkills OpportunitySkill[]
}

model StudentSkill {
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level           String?        // 'beginner', 'intermediate', 'advanced'
  yearsExperience Float?

  @@id([studentId, skillId])
}

model Experience {
  id               String            @id @default(uuid())
  studentId        String
  student          StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization     String
  position         String
  startDate        DateTime?
  endDate          DateTime?
  description      String?
  achievements     String?           // JSON array string
  experienceSkills ExperienceSkill[]
}

model ExperienceSkill {
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
}

model Project {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  technologies String?        // JSON array string
  role         String?
  projectUrl   String?
  githubUrl    String?
}

model Certification {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  issuer        String?
  issuedDate    DateTime?
  credentialId  String?
  credentialUrl String?
}

model Course {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  provider      String?
  completedDate DateTime?
  skillsLearned String?        // JSON array string
}

model CommunityWork {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization String?
  role         String?
  duration     String?
  description  String?
}

model Leadership {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String?
  organization String?
  description  String?
}

model Achievement {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String?
  description String?
  date        DateTime?
}

model StudentPreference {
  studentId                 String         @id
  student                   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityTypes          String         // JSON array: ['job','internship','scholarship','fellowship']
  workMode                  String         @default("any") // 'remote','onsite','hybrid','any'
  preferredLocations        String?        // JSON array
  minMatchThreshold         Int            @default(92)
  emailNotificationsEnabled Boolean        @default(true)
  emailFrequency            String         @default("immediate")
  updatedAt                 DateTime       @default(now()) @updatedAt
}

model Opportunity {
  id                    String                  @id @default(uuid())
  recruiterId           String?
  recruiter             RecruiterProfile?       @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  sourceType            String                  @default("manual") // 'manual','scraped'
  sourceId              String?
  title                 String
  type                  String                  // 'job','internship','scholarship','fellowship','competition','research','training','volunteer'
  organization          String
  description           String?
  responsibilities      String?
  location              String?
  isRemote              Boolean                 @default(false)
  compensation          String?
  applicationDeadline   DateTime
  applicationUrl        String?
  applyInPlatform       Boolean                 @default(false)
  status                String                  @default("draft") // 'draft','submitted','published','rejected','closed','expired'
  reviewedBy            String?
  reviewer              Profile?                @relation("AdminReviewedOpportunities", fields: [reviewedBy], references: [id])
  reviewedAt            DateTime?
  opportunityEmbedding  String?                 // JSON vector string
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt

  requirements          OpportunityRequirement?
  skills                OpportunitySkill[]
  matches               Match[]
  emailLogs             EmailLog[]
  applications          Application[]
}

model OpportunityRequirement {
  opportunityId      String      @id
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  minGpa             Float?
  minGpaScale        Float       @default(4.0)
  requiredDegrees    String?     // JSON array
  minExperienceYears Float       @default(0)
  minAcademicYear    Int?
}

model OpportunitySkill {
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requirementType String      // 'required', 'preferred'

  @@id([opportunityId, skillId, requirementType])
}

model Match {
  id                String         @id @default(uuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  eligibilityStatus String         // 'pass', 'fail'
  semanticScore     Float?
  skillScore        Float?
  educationScore    Float?
  experienceScore   Float?
  finalScore        Float?

  matchingModel     String?
  explanation       String?        // JSON string with reasons, strong matches, missing skills
  createdAt         DateTime       @default(now())

  @@unique([studentId, opportunityId])
}

model EmailLog {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recipientEmail String
  subject        String
  body           String?
  sentAt         DateTime       @default(now())
  deliveryStatus String         @default("sent") // 'sent','failed','bounced'
  openedAt       DateTime?
  clickedAt      DateTime?

  @@unique([studentId, opportunityId])
}

model Application {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        String         @default("saved") // 'saved','viewed','applied','interview','rejected','selected'
  updatedAt     DateTime       @default(now()) @updatedAt

  @@unique([studentId, opportunityId])
}

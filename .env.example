# Database Configuration
# Supports SQLite for instant local zero-config testing: "file:./dev.db"
# Or PostgreSQL for production/pgvector: "postgresql://postgres:postgres@localhost:5432/opportunity_matcher?schema=public"
DATABASE_URL="file:./dev.db"

# Gemini Embedding Configuration (Google GenAI)
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Qwen Embedding Configuration (DashScope / OpenAI-compatible endpoint)
QWEN_API_KEY=""
QWEN_EMBEDDING_MODEL="text-embedding-v3"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# Ollama Local Embedding Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
